# Copiar a `.env` y completar. El `.env` NUNCA se sube al repositorio.

# ── Base de datos ─────────────────────────────────────────────────────────────
# En producción, usar una contraseña fuerte (no "password").
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=informes_db
DATABASE_URL=postgresql://usuario:password@postgres:5432/informes_db

# ── Seguridad ─────────────────────────────────────────────────────────────────
# OBLIGATORIO cambiarla en producción: con una clave débil se pueden falsificar
# tokens de cualquier usuario. El backend se niega a arrancar si sigue siendo la
# de ejemplo y ENVIRONMENT=production.
#   Generar con:  openssl rand -hex 32
SECRET_KEY=cambiar-en-produccion-usar-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Entorno ───────────────────────────────────────────────────────────────────
APP_NAME=Sistema Informes UPS
# development | production
#   production: oculta /docs y /redoc, y exige una SECRET_KEY fuerte.
ENVIRONMENT=development

# Orígenes permitidos por CORS, separados por comas.
# En producción, el dominio real:  https://informes.ups.edu.ec
CORS_ORIGINS=http://localhost:5173,http://localhost

# ── Inteligencia artificial ───────────────────────────────────────────────────
# groq (free tier, sin tarjeta) | deepseek | gemini | anthropic
AI_PROVIDER=groq
AI_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── Correo saliente (SMTP) ────────────────────────────────────────────────────
# En producción debe ser una cuenta INSTITUCIONAL, no personal.
# Gmail impone un límite de envíos diarios que una tanda de correos puede superar.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ── Correo entrante (IMAP) ────────────────────────────────────────────────────
# Para leer las respuestas de los docentes y correlacionarlas por token Reply-To.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
REPLY_TO_DOMAIN=
